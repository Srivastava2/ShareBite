# Server Port
PORT=5000

# MongoDB Connection String:
# Option 1: Local MongoDB (Default)
MONGO_URI=mongodb://127.0.0.1:27017/sharebite

# Option 2: MongoDB Atlas Cloud (Recommended for teams so nobody needs local MongoDB)
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/sharebite?retryWrites=true&w=majority

# JWT Secret Key for token signing
JWT_SECRET=sharebite_super_secret_jwt_key_2026
